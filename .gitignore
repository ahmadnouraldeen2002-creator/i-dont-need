# Secrets and environment files (only .env.example is committed)
.env
.env.*
!.env.example
*.local

# Signing keys and certificates
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer

# Firebase config (provided to EAS builds as file variables, never via git)
google-services.json
GoogleService-Info.plist

# Service-account and credential JSON files
*service-account*.json
*serviceAccount*.json
*-credentials.json
credentials.json
.git-credentials

# Supabase local state
supabase/.temp/
supabase/.branches/
supabase/.env

# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native folders generated by prebuild
/ios
/android
.kotlin/
*.orig.*

# Build outputs
build/
*.apk
*.aab
*.ipa
*.tsbuildinfo
coverage/

# Metro
.metro-health-check*

# Debug and logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Database dumps and data exports (no real user data in git)
*.dump
*.sql.gz
*.backup

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
