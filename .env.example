# Copy this file to `.env` and fill in the values for your machine.
# `.env` is git-ignored and must never be committed (CLAUDE.md S12, S28).
#
# Every EXPO_PUBLIC_* value is bundled into the app, so anyone who downloads the app can read it.
# Only the four public values below may go here (CLAUDE.md section 4).
# Real secrets (Supabase secret keys, OAuth client secrets, signing keys) never go in this file:
# they live only in Supabase secrets, EAS secrets or GitHub Actions secrets.

# Supabase dev project (step 0.7). Use the publishable key (sb_publishable_...), not the legacy anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry DSN (added when Sentry is set up).
EXPO_PUBLIC_SENTRY_DSN=

# Map tile provider key (provider chosen at M5).
EXPO_PUBLIC_MAP_KEY=
